# Drizzle
# Replace with your DB credentials!
DATABASE_URL="libsql://db-name-user.turso.io"
# A local DB can also be used in dev as well
# DATABASE_URL="file:local.db"
DATABASE_AUTH_TOKEN=""

ORIGIN=""

# Better Auth
# For production use 32 characters and generated with high entropy
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL=""

# Admin authentication
# Comma-separated list of Gmail addresses allowed to access /admin
ADMIN_EMAILS="email1@gmail.com,email2@gmail.com,email3@gmail.com"

# Google OAuth (used by Better Auth for admin sign-in)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
